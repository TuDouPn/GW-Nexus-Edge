<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gwnexusedge</groupId>
        <artifactId>nexus-edge-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>nexus-edge-agentscope-adapter</artifactId>
    <name>GW Nexus Edge - AgentScope Adapter</name>
    <description>
        DEV-0001 兼容性验证用的 AgentScope Java 2.0.1 Adapter。
        依赖领域 Port（nexus-edge-domain-agentscope-port）与官方 AgentScope SDK。
        领域层不依赖本 Adapter。
    </description>

    <dependencies>
        <!-- 领域 Port：本 Adapter 唯一实现的契约。 -->
        <dependency>
            <groupId>com.gwnexusedge</groupId>
            <artifactId>nexus-edge-domain-agentscope-port</artifactId>
        </dependency>

        <!--
          AgentScope 官方 SDK，版本由 agentscope-bom:2.0.1 导入。
          agentscope-harness 传递引入 agentscope-core（HarnessAgent / ReActAgent / Typed Event）。
          OpenAI 兼容模型扩展：DEV-0001 仅用于受控测试端点；它是下游模型 Test Double，
          不是 Fake AgentScope，只能证明运行时与协议集成，不构成任何生产认证。
        -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-redis</artifactId>
            <!--
              Redis 状态存储扩展已核验 2.0.1 存在。
              恢复边界（OQ-007）先由能力矩阵建立结论，再决定是否启用 Redis 测试；
              参见 RecoveryCapabilityReportTest 与 docs/blueprint/08 §9、22 §6。
            -->
        </dependency>

        <!-- Spring Boot 用于 G-01：验证 Harness/Core 可内嵌于 Spring Boot 4.1.0 上下文。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 测试范围 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!--
                  第四轮：排除 android-json（jsonassert 的重复 JSONObject 来源）。
                  Spring Boot DuplicateJsonObjectContextCustomizer 警告两个 org.json.JSONObject；
                  jsonassert 可运行时使用 classpath 中唯一剩余的 org.json（json-20251224）。
                -->
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          DEV-0003：AgentScope 官方 Redis Persistence/Recovery 扩展（agentscope-bom 管理 2.0.1）。
          - RedisAgentStateStore implements AgentStateStore（Jedis/Lettuce/Redisson 客户端，实证）。
          - 传递依赖：jedis 7.4.1 / redisson 4.2.0 / lettuce-core 6.4.2.RELEASE（POM 实证）；
            本 reactor 依赖调解使 lettuce 为 SB BOM 的 7.5.2（兼容性经 DEV-0003 测试验证，评审 0.4-3）。
        -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-redis</artifactId>
        </dependency>
        <!--
          OpenTelemetry SDK（test scope）：DEV-0001 验证真实 Trace ID 采集。
          AgentScope core 已传递 opentelemetry-api 1.61.0 与 reactor-3.1 桥接；
          测试注入 SDK 使 GlobalOpenTelemetry 产生真实 span，从而采集真实 traceId。
          sdk-testing 提供 InMemorySpanExporter（第四轮：父子 span 关联验证）。
        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-trace</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 用于可选的 Redis 恢复测试（仅在能力矩阵支持时启用）；版本由 SB 4.1.0 BOM 管理（2.0.5）。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              默认排除 Provider Smoke 测试（ProviderSmokeTest）：
              仅在 provider-smoke 独立 Profile 显式启用时运行（评审 0.4-4）。
              Profile 显式启用但缺少真实凭证时，该测试 fail-closed（BLOCKED_BY_CREDENTIAL），
              禁止把跳过写成通过证据。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/ProviderSmokeTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Provider Smoke 独立 Profile（DEV-0003 / 评审 0.4-4）：
          - 显式启用：./mvnw -P provider-smoke -pl nexus-edge-agentscope-adapter test -Dtest=ProviderSmokeTest
          - 凭证经环境变量注入（DEEPSEEK_API_KEY/DEEPSEEK_BASE_URL 或 OPENAI_API_KEY/OPENAI_BASE_URL），
            不写入代码/YAML/DB/报告/日志；
          - 无凭证 → ProviderSmokeTest fail-closed（BLOCKED_BY_CREDENTIAL），不 Mock 冒充。
        -->
        <profile>
            <id>provider-smoke</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- 清空默认 excludes：Profile 显式启用时运行 Provider Smoke 测试 -->
                            <excludes combine.self="override" />
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
